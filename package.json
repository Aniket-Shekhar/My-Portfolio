{
  "name": "my-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "lint": "oxlint src"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "framer-motion": "^12.41.0",
    "lenis": "^1.3.4",
    "mongoose": "^8.9.5",
    "nodemailer": "^6.10.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.1.2",
    "oxlint": "^1.69.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.2",
    "vite": "^8.1.0"
  }
}
